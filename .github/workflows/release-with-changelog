name: android sdk release

on:
  push:
    tags:
      - '*'
  workflow_dispatch:
    inputs:
      tag:
        description: 'release tag'
        required: false
        type: string
      publish_release:
        description: 'whether to publish to github release'
        required: false
        type: boolean
        default: true

permissions:
  contents: write

jobs:
  get-version:
    runs-on: ubuntu-22.04
    timeout-minutes: 60
    outputs:
      version: ${{ steps.get_version.outputs.VERSION }}
    steps:
      - name: Get Version
        id: get_version
        run: |-
          if [ ${{ github.event_name }} == 'workflow_dispatch' ]; then
            version=${{ github.event.inputs.tag }}
          else
            version=$(echo ${{ github.ref }} | awk -F "/" '{print $3}')
          fi
          if [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || \
                $version =~ ^[0-9]+\.[0-9]+\.[0-9]+-rc\.[0-9]+$ || \
                $version =~ ^[0-9]+\.[0-9]+\.[0-9]+-alpha\.[0-9]+$ ]]; then
            echo "Version is valid"
            echo "VERSION=$version" >> $GITHUB_OUTPUT;
          else
            echo "Version is invalid"
            exit 1
          fi

  release:
    runs-on: ubuntu-22.04
    needs: get-version
    steps:
    - name: Download Source
      uses: actions/checkout@v4.2.2

    - name: Build artifact
      run: |-
        mkdir -p build
        cd js
        zip -r ../build/js.zip .
      id: build_artifact

    - name: Get release info
      id: get_release
      uses: octokit/request-action@v2.x
      with:
        route: GET /repos/${{ github.repository }}/releases/tags/${{ needs.get-version.outputs.version }}
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

    - name: Push to release
      if: ${{ github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs.publish_release == true) }}
      uses: ncipollo/release-action@v1
      with:
        tag: ${{ steps.get_tag.outputs.VERSION }}
        token: ${{ secrets.GITHUB_TOKEN }}
        replacesArtifacts: true
        allowUpdates: true
        artifacts: "build/js.zip"
        draft: ${{ fromJSON(steps.get_release.outputs.data).draft }}
        prerelease: ${{ fromJSON(steps.get_release.outputs.data).prerelease }}
